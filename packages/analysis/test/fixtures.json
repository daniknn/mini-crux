  "benjaminiHochberg": [
    {
      "name": "monotonicity_step_up",
      "why": "Raw q = p\u00b7m/i is non-monotone here (i=3 gives 0.078, i=5 gives 0.0504), so the step-up from the largest p downward is what produces the answer. Without it, feature 3 reports a q larger than feature 5's despite a smaller p.",
      "p": [
        0.001,
        0.008,
        0.039,
        0.041,
        0.042,
        0.6
      ],
      "q": [
        0.006,
        0.024,
        0.0504,
        0.0504,
        0.0504,
        0.6
      ]
    },
    {
      "name": "unsorted_input",
      "why": "The same p-values shuffled. BH sorts internally and must hand results back in the caller's order \u2014 a mismatch here attaches every q to the wrong feature name.",
      "p": [
        0.042,
        0.001,
        0.6,
        0.039,
        0.008,
        0.041
      ],
      "q": [
        0.0504,
        0.006,
        0.6,
        0.0504,
        0.024,
        0.0504
      ]
    },
    {
      "name": "large_p_values",
      "why": "Raw p\u00b7m/i runs past 1 here (0.4\u00b74/1 = 1.6), and the step-up brings every value back down to the largest p. No clamp is needed and none is present: max(q) equals max(p) exactly.",
      "p": [
        0.4,
        0.7,
        0.9,
        0.95
      ],
      "q": [
        0.95,
        0.95,
        0.95,
        0.95
      ]
    },
    {
      "name": "single_test",
      "why": "m = 1: BH is the identity.",
