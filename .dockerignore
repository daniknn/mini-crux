# Keep the build context small and, more importantly, keep the *host's* installed
# dependencies out of it.
#
# `node_modules` is the one that matters. pnpm fills it with absolute symlinks into a store
# at the developer's home directory; copying that into an image produces a tree of dangling
# links that fails at import time rather than at build time. The image installs its own.
node_modules
.pnpm-store

# Build and tool output — regenerated in the image, and stale copies only confuse.
.turbo
.next
dist
coverage
**/__pycache__
**/*.pyc
.venv

# Never in an image, under any circumstances. Secrets come from Doppler through the
# platform's injection, never from a file baked into a layer that anyone who pulls the
# image can read (UC-6 rule 6).
.env
.env.*
!.env.example

# Not needed to run anything.
.git
.github
.dashone
specs
*.md
!README.md
