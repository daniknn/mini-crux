# Placeholders only. Doppler is the single source of truth for real values.
# Local dev:  doppler run -- pnpm dev

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_SECRET=<jwt-secret>
# Direct (non-pooled) connection — the migration runner issues DDL and needs a session,
# and the role must be BYPASSRLS to create policies.
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
# The dashboard's connection, and a different role on purpose. `authenticator` has no rights
# of its own; every request switches it to `authenticated` for the length of one transaction,
# so RLS applies to the app exactly as it applies in the tests. Pointing the dashboard at the
# BYPASSRLS URL above would serve every workspace's panel to everyone, with a green suite.
# Pooled (port 6543) because Vercel functions are many, short-lived, and cheap to start.
SUPABASE_DB_AUTHENTICATOR_URL=postgresql://authenticator:<password>@db.<project>.supabase.co:6543/postgres

# ─── Clerk ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── Health / alarm ──────────────────────────────────────────────────────────
# Gates GET /api/health/ingestion, which reports the crawl state of every active watchlist
# across the whole instance. An uptime checker cannot hold a Clerk session, so this is a
# shared secret sent as `authorization: Bearer <token>`. Generate with `openssl rand -hex 32`.
HEALTH_CHECK_TOKEN=<random-32-byte-hex>

# ─── Apify (Meta Ad Library ingestion) ───────────────────────────────────────
APIFY_TOKEN=<apify-token>
APIFY_AD_LIBRARY_ACTOR_ID=<actor-id>
# Storage bucket holding the immutable raw snapshots. Must be private and versioning is
# unnecessary — snapshots are written once and never replaced.
SUPABASE_RAW_BUCKET=raw

# ─── Extractor worker (Python, Fly.io) ───────────────────────────────────────
JOB_POLL_INTERVAL_MS=2000
# Storage bucket for landed creative media. Separate from the raw snapshot bucket: these
# are the bytes every feature was measured from, and a schema-version bump re-reads them
# long after the signed Ad Library URL has expired.
SUPABASE_MEDIA_BUCKET=media
WHISPER_MODEL=tiny
EXTRACTOR_MAX_VIDEO_SECONDS=120

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=<otlp-endpoint>
